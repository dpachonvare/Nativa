# NATIVA — variables de entorno

# Lista VIP: URL del Web App de Google Apps Script (ver docs/email-setup.md).
# Si se deja vacía, el formulario funciona en "modo demo" (no guarda nada).
GOOGLE_SCRIPT_URL=

# ---- Tienda / Carrito (Stripe) ----
# Enciende la tienda (muestra "Añadir al carrito" y el carrito). Debe ser "true".
# Mientras no exista o sea distinto de "true", el sitio muestra "Únete a la lista".
NEXT_PUBLIC_COMMERCE_ENABLED=

# Moneda de cobro (código ISO de 3 letras). Default: AUD.
NEXT_PUBLIC_CURRENCY=AUD

# Clave secreta de Stripe (Dashboard → Developers → API keys). NO la subas al repo.
STRIPE_SECRET_KEY=

# URL pública del sitio (para los enlaces de regreso tras el pago).
# Ej.: https://nativa.com.au  (si se omite, se usa el origen de la petición).
NEXT_PUBLIC_SITE_URL=
